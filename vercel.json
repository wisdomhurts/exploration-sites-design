{
  "buildCommand": "npx @11ty/eleventy",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/the-standard.html",
      "destination": "/why.html",
      "permanent": true
    },
    { "source": "/nurture-crm.html", "destination": "/hosting.html#investor-tools", "permanent": true },
    { "source": "/investor-analytics.html", "destination": "/hosting.html#investor-tools", "permanent": true },
    { "source": "/exploration-today-ai.html", "destination": "/services.html", "permanent": false },
    { "source": "/sections.html", "destination": "/drilling.html", "permanent": true },
    { "source": "/sections{/}?", "destination": "/drilling.html", "permanent": true },
    { "source": "/conceptual-schematic.html", "destination": "/schematics-plans.html", "permanent": true },
    { "source": "/conceptual-schematic{/}?", "destination": "/schematics-plans.html", "permanent": true },
    { "source": "/maps{/}?", "destination": "/investor-maps.html", "permanent": true },
    { "source": "/home{/}?", "destination": "/", "permanent": true },
    { "source": "/:slug([a-z0-9-]+){/}?", "destination": "/:slug.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.msgsndr.com https://*.leadconnectorhq.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://formspree.io https://*.msgsndr.com https://*.leadconnectorhq.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://*.leadconnectorhq.com https://*.msgsndr.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io https://checkout.stripe.com https://buy.stripe.com; frame-ancestors 'self'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/styles.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
    },
    {
      "source": "/assets/three/r169/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    }
  ]
}
