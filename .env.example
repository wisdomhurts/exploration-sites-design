# Environment variables for the Stripe checkout (api/checkout.mjs, api/stripe-webhook.mjs).
# Set real values in Vercel → Project es-draft-1 → Settings → Environment Variables.
# Never commit real keys. Use sk_test_/test price IDs in Preview, live ones in Production.

# Stripe API secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...

# Signing secret of the webhook endpoint pointing at https://<site>/api/stripe-webhook
# Events: checkout.session.completed, invoice.payment_failed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# Recurring monthly prices for each NRMP tier (CAD)
STRIPE_PRICE_NRMP_CADENCE=price_...
STRIPE_PRICE_NRMP_ACTIVE=price_...
STRIPE_PRICE_NRMP_FULL=price_...
# One-time base setup price, added to the first invoice
STRIPE_PRICE_NRMP_SETUP=price_...

# Resend (resend.com) — order notification emails
RESEND_API_KEY=re_...
# Sender must be on a domain verified in Resend
EMAIL_FROM=Exploration Sites <billing@explorationsites.com>
# Optional; defaults to accounts@explorationsites.com
NOTIFY_EMAIL=accounts@explorationsites.com
